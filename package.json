{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "engines": {
        "node": ">=22",
        "npm": ">=10"
    },
    "type": "module",
    "scripts": {
        "build": "vp build",
        "build:ssr": "vp build && vp build --ssr",
        "dev": "vp dev",
        "lint": "eslint . --fix --max-warnings 0",
        "lint:check": "eslint . --max-warnings 0",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "check": "npm run lint:check && npm run format:check",
        "check:fix": "npm run lint && npm run format",
        "types:check": "vue-tsc --noEmit"
    },
    "dependencies": {
        "@inertiajs/vite": "^3.0.0",
        "@inertiajs/vue3": "^3.0.0",
        "@lucide/vue": "^1.17.0",
        "@vueuse/core": "^12.8.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "laravel-vite-plugin": "^3.0.0",
        "reka-ui": "^2.9.8",
        "tailwind-merge": "^3.2.0",
        "tailwindcss": "^4.1.1",
        "tw-animate-css": "^1.2.5",
        "vue": "^3.5.13"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@laravel/vite-plugin-wayfinder": "^0.1.3",
        "@tailwindcss/vite": "^4.1.11",
        "@types/node": "^22.13.5",
        "@vitejs/plugin-vue": "^6.0.0",
        "@vue/eslint-config-typescript": "^14.9.0",
        "concurrently": "^10.0.3",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.12.0",
        "prettier": "^3.9.10",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "typescript": "^5.2.2",
        "typescript-eslint": "^8.72.1",
        "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
        "vite-plus": "1.4.0",
        "vue-tsc": "^3.3.13"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1",
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@rollup/rollup-win32-x64-msvc": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "@tailwindcss/oxide-win32-x64-msvc": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1",
        "lightningcss-win32-x64-msvc": "^1.29.1"
    },
    "overrides": {
        "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
    }
}
